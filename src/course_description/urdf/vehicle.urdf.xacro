<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <!-- Размеры из models/course_ackermann/model.sdf (м, кг, с; REP-103). -->
  <xacro:property name="base_length" value="1.05"/>
  <xacro:property name="base_width" value="0.52"/>
  <xacro:property name="base_height" value="0.22"/>
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="track_width" value="0.62"/>
  <xacro:property name="wheel_base" value="0.80"/>
  <xacro:property name="body_z" value="0.12"/>
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_z" value="0.38"/>
  <xacro:property name="sensor_mass" value="0.033"/>

  <xacro:macro name="box_inertia" params="m x y z xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+l*l)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r+l*l)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sensor_link" params="name xyz parent:=base_link">
    <link name="${name}">
      <xacro:box_inertia m="${sensor_mass}" x="0.05" y="0.05" z="0.05"/>
      <visual>
        <geometry><box size="0.05 0.05 0.05"/></geometry>
        <material name="sensor_grey"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.05 0.05 0.05"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix xyz">
    <link name="${prefix}_wheel">
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"><color rgba="0.04 0.04 0.04 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <link name="base_link">
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" xyz="0 0 ${body_z}"/>
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Сенсоры: parent = base_link (контракт ПР06). -->
  <xacro:sensor_link name="camera_link" xyz="${sensor_x} 0 ${sensor_z}"/>
  <xacro:sensor_link name="lidar_link" xyz="${sensor_x} 0 ${sensor_z}" parent="camera_link"/>
  <xacro:sensor_link name="imu_link" xyz="${sensor_x} 0 ${sensor_z}"/>

  <xacro:wheel prefix="front_left" xyz="${wheel_base/2} ${track_width/2} 0"/>
  <xacro:wheel prefix="front_right" xyz="${wheel_base/2} ${-track_width/2} 0"/>
  <xacro:wheel prefix="rear_left" xyz="${-wheel_base/2} ${track_width/2} 0"/>
  <xacro:wheel prefix="rear_right" xyz="${-wheel_base/2} ${-track_width/2} 0"/>
</robot>
